{
  "name": "local-captcha-solver",
  "version": "1.3.1",
  "description": "Local, privacy-first text CAPTCHA recognition for Chrome, Edge, and Firefox.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongshuo-wang/local-captcha-solver.git"
  },
  "bugs": {
    "url": "https://github.com/hongshuo-wang/local-captcha-solver/issues"
  },
  "homepage": "https://github.com/hongshuo-wang/local-captcha-solver#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:captcha-ctc:chrome": "tsx scripts/build-captcha-ctc.ts chrome",
    "build:captcha-ctc:edge": "tsx scripts/build-captcha-ctc.ts edge",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "npm run zip:chrome",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "verify:firefox": "node scripts/verify-firefox-build.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:extension": "playwright test -c playwright.extension.config.ts",
    "test:e2e:slider:edge": "CAPTCHA_E2E_TARGET=edge CAPTCHA_E2E_HEADLESS=1 playwright test -c playwright.extension.config.ts -g 'automatically handles a supported slider'",
    "test:e2e:recognition:chrome": "CAPTCHA_E2E_TARGET=chrome playwright test tests/e2e/recognition.spec.ts",
    "test:e2e:recognition:edge": "CAPTCHA_E2E_TARGET=edge playwright test tests/e2e/recognition.spec.ts",
    "assets:sync": "node scripts/sync-third-party-assets.mjs",
    "benchmark:generate": "tsx benchmark/generate-corpus.ts",
    "benchmark:ppocrv6:fetch": "tsx benchmark/fetch-ppocrv6-assets.ts",
    "benchmark:ppocrv6": "tsx benchmark/run-ppocrv6.ts",
    "benchmark:captcha-ctc": "tsx benchmark/run-captcha-ctc.ts",
    "training:ppocrv6:fetch": "tsx training/ppocrv6-captcha/fetch-assets.ts",
    "training:public:fetch": "tsx training/ppocrv6-captcha/fetch-public-dataset.ts",
    "training:public:import": "tsx training/ppocrv6-captcha/import-public-dataset.ts",
    "training:synthetic:generate": "tsx training/ppocrv6-captcha/generate-synthetic.ts",
    "training:labels:balance": "tsx training/ppocrv6-captcha/materialize-balanced-labels.ts",
    "training:ctc:smoke": "training/ppocrv6-captcha/.venv/bin/python training/ppocrv6-captcha/train_ctc.py --smoke",
    "training:ctc:train": "training/ppocrv6-captcha/.venv/bin/python training/ppocrv6-captcha/train_ctc.py",
    "benchmark:production": "tsx benchmark/run-captcha-ctc.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@fontsource/kalam": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@napi-rs/canvas": "1.0.8",
    "@playwright/test": "1.62.1",
    "@types/adm-zip": "0.5.8",
    "@vitest/coverage-v8": "4.1.11",
    "adm-zip": "0.6.0",
    "csv-parse": "7.0.2",
    "dejavu-fonts-ttf": "2.37.3",
    "happy-dom": "20.12.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "fx-runner": "1.5.0",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
