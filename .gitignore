!benchmark/fixtures/**
!benchmark/corpus/
!benchmark/corpus/**

# Runtime assets are deliberately pinned and committed.
!public/models/
!public/models/**
!public/ort/
!public/ort/**

# Training documentation is source, even when a global gitignore excludes docs/.
!docs/
docs/*
!docs/model-training.md
!docs/production-model-reproduction.md
